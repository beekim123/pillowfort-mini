{
  "extends": "./temp/tsconfig.cocos.json",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "assets/scripts/**/*.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "tools"
  ]
}
