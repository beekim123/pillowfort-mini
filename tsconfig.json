{
  "extends": "./temp/tsconfig.cocos.json",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "assets/scripts/**/*.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "tools"
  ]
}
